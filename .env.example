# Isi dengan token acak minimal 32 karakter sebelum membuat admin di /petugas.
JRCARE_SETUP_TOKEN=

# Pengaturan untuk menjalankan aplikasi di komputer sendiri.
HOST=127.0.0.1
PORT=3000
JRCARE_DATABASE=./data/jrcare.sqlite

# Untuk produksi, gunakan alamat HTTPS aplikasi dan aktifkan NODE_ENV=production.
# JRCARE_ORIGIN=https://chat.example.com
# NODE_ENV=production

# Aktifkan hanya jika reverse proxy mengganti X-Real-IP dengan IP pengunjung.
# JRCARE_TRUST_PROXY=1
